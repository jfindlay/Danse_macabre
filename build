#!/usr/bin/env python3
"""Project build entry point: the score, the programme notes, and the reference-score tooling.

With no command, builds the score and the notes.
"""

from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
from collections.abc import Sequence
from pathlib import Path

ROOT = Path(__file__).resolve().parent
ARRANGEMENT = ROOT / "arrangement"
SCORE_SOURCE = "danse-macabre-solo.ly"
TOOLS = ROOT / "tools"
DUMP_ABS = ARRANGEMENT / "dump" / "abs"  # regenerated by `build dump`; git-ignored
NOTES_SOURCE = ROOT / "Program notes.md"
NOTES_PDF = ROOT / "Program notes.pdf"

# DejaVu Serif carries every glyph the notes use (music flat/natural/sharp, quadruple prime).
DEFAULT_NOTES_FONT = "DejaVu Serif"

# Mirrors TRANSPOSE_PRESETS in tools/slice.py.
TRANSPOSE_PRESETS = ("cl-bb", "horn-g", "horn-eb", "horn-d", "tp-d")


def run(cmd: Sequence[str | Path], cwd: Path | None = None) -> int:
    """Run a command, inheriting stdio.

    :param cmd: The program and its arguments.
    :param cwd: Working directory, or ``None`` for the current one.
    :returns: The command's exit status.
    """
    return subprocess.run([str(part) for part in cmd], cwd=cwd, check=False).returncode


def require(*programs: str) -> bool:
    """Check that external programs are on ``PATH``, reporting any that are missing.

    :param programs: Program names to look up.
    :returns: ``True`` if every program was found.
    """
    missing = [program for program in programs if shutil.which(program) is None]
    for program in missing:
        print(f"build: {program} not found on PATH", file=sys.stderr)
    return not missing


def build_score() -> int:
    """Compile the score to ``arrangement/danse-macabre-solo.pdf``.

    :returns: The exit status.
    """
    if not require("lilypond"):
        return 127
    return run(["lilypond", SCORE_SOURCE], cwd=ARRANGEMENT)


def build_notes(font: str) -> int:
    """Render ``Program notes.md`` to ``Program notes.pdf`` with pandoc and xelatex.

    :param font: Main font family for the PDF.
    :returns: The exit status.
    """
    if not require("pandoc", "xelatex"):
        return 127
    status = run(
        [
            "pandoc",
            NOTES_SOURCE,
            "-o",
            NOTES_PDF,
            "--pdf-engine=xelatex",
            "-V",
            f"mainfont={font}",
            "-V",
            "fontsize=10pt",
            "-V",
            "geometry:margin=2.5cm",
            "-V",
            "colorlinks=true",
        ]
    )
    if status == 0:
        print(f"wrote {NOTES_PDF}")
    return status


def build_all(font: str) -> int:
    """Build the score, then the notes, stopping at the first failure.

    :param font: Main font family for the notes PDF.
    :returns: The first non-zero exit status, or 0.
    """
    return build_score() or build_notes(font)


def build_dump() -> int:
    """Regenerate the absolute-pitch dumps from the orchestral LilyPond source.

    :returns: The exit status.
    """
    if not require("lilypond"):
        return 127
    if not require("convert-ly"):
        return 127
    return run([sys.executable, TOOLS / "build_dump.py"])


def slice_dump(args: Sequence[str]) -> int:
    """Run the bar slicer against the dumps.

    :param args: Arguments for ``slice.py`` after the dump directory.
    :returns: The exit status.
    """
    if not DUMP_ABS.is_dir():
        print("build: no dumps yet; run `build dump` first", file=sys.stderr)
        return 1
    return run([sys.executable, TOOLS / "slice.py", DUMP_ABS, *args])


def slice_args(args: argparse.Namespace) -> list[str] | None:
    """Translate parsed ``slice`` options into ``slice.py`` arguments.

    :param args: The parsed command line.
    :returns: The argument list, or ``None`` if the voice and bar range are incomplete.
    """
    if args.verify_all:
        return ["--verify-all"]
    if args.voice is None or args.start is None or args.end is None:
        return None
    result = [args.voice, str(args.start), str(args.end)]
    if args.transpose is not None:
        result += ["--transpose", args.transpose]
    return result


def make_parser() -> argparse.ArgumentParser:
    """Build the command-line parser.

    :returns: The parser.
    """
    parser = argparse.ArgumentParser(
        prog="build", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "--font",
        default=os.environ.get("NOTES_FONT", DEFAULT_NOTES_FONT),
        help="main font for the notes PDF (default: $NOTES_FONT or %(default)s)",
    )
    sub = parser.add_subparsers(dest="command", metavar="command")
    sub.add_parser("all", help="the score and the notes (the default)")
    sub.add_parser("score", help=f"{SCORE_SOURCE} -> arrangement/danse-macabre-solo.pdf")
    sub.add_parser("notes", help='"Program notes.md" -> "Program notes.pdf" (pandoc + xelatex)')
    sub.add_parser("dump", help="regenerate arrangement/dump/abs from source/lilypond")
    sub.add_parser("verify", help="check every dump is exactly 477 bars of 3/4")
    slicer = sub.add_parser(
        "slice",
        help="print bars of one orchestral voice in absolute pitch",
        description="Print bars START..END of VOICE (e.g. Pic, Cl1, V1a, Vc-a).",
    )
    slicer.add_argument("voice", nargs="?", help="voice name, as in arrangement/dump/abs")
    slicer.add_argument("start", nargs="?", type=int, help="first bar")
    slicer.add_argument("end", nargs="?", type=int, help="last bar")
    slicer.add_argument("--transpose", choices=TRANSPOSE_PRESETS, help="show sounding pitch")
    slicer.add_argument("--verify-all", action="store_true", help="same as the verify command")
    return parser


def main(argv: Sequence[str]) -> int:
    """Parse the command line and dispatch.

    :param argv: Command-line arguments, without the program name.
    :returns: The process exit status.
    """
    parser = make_parser()
    args = parser.parse_args(argv)
    match args.command:
        case None | "all":
            return build_all(args.font)
        case "score":
            return build_score()
        case "notes":
            return build_notes(args.font)
        case "dump":
            return build_dump()
        case "verify":
            return slice_dump(["--verify-all"])
        case _:  # "slice": the parser admits no other command
            if (forwarded := slice_args(args)) is None:
                parser.error("slice needs VOICE START END, or --verify-all")
            return slice_dump(forwarded)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
